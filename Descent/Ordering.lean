import Descent.Replacement

/-!
# The Dershowitz–Manna order, generated by single replacements

Mathlib proves `Multiset.wellFounded_isDershowitzMannaLT` through a private single-replacement
relation, so its characterization of the order is not available downstream. This module proves
that characterization publicly for `Replacement`: the Dershowitz–Manna order is exactly the
transitive closure of replacing one element by finitely many strictly smaller ones.

It also shows that the order is irreflexive over every preorder, packages it as a partial order
on the type synonym `DM α`, and iterates it into `Nested d`, the multisets nested to depth `d`.
Each level is well founded by `d` applications of Mathlib's theorem.
-/

namespace Descent

open Multiset Relation

variable {α : Type*} [Preorder α] {M N : Multiset α}

theorem dm_of_transGen_replacement (h : TransGen Replacement M N) :
    IsDershowitzMannaLT M N :=
  h.trans_induction_on (fun step => replacement_dm step) fun _ _ => IsDershowitzMannaLT.trans

/-- Every Dershowitz–Manna descent factors into single replacements. The elements below the
first replaced element `z` are produced by one replacement; the rest are handled inductively. -/
theorem transGen_replacement_of_dm (h : IsDershowitzMannaLT M N) :
    TransGen Replacement M N := by
  classical
  obtain ⟨X, Y, Z, hZ, rfl, rfl, hYZ⟩ := h
  induction Z using Multiset.induction_on generalizing X Y with
  | empty => exact absurd Multiset.empty_eq_zero.symm hZ
  | cons z Z ih =>
    rcases eq_or_ne Z 0 with rfl | hZ'
    · exact .single ⟨X, Y, z, rfl, by simp, fun y hy => by simpa using hYZ y hy⟩
    have hrest := ih (X + Y.filter (· < z)) (Y.filter fun y => ¬ y < z)
      (by simpa [Multiset.empty_eq_zero] using hZ') fun y hy => by
        obtain ⟨hyY, hyz⟩ := Multiset.mem_filter.1 hy
        obtain ⟨w, hw, hyw⟩ := hYZ y hyY
        rcases Multiset.mem_cons.1 hw with rfl | hwZ
        · exact absurd hyw hyz
        · exact ⟨w, hwZ, hyw⟩
    rw [add_assoc, Multiset.filter_add_not] at hrest
    refine hrest.tail ⟨X + Z, Y.filter (· < z), z, add_right_comm _ _ _, ?_,
      fun y hy => (Multiset.mem_filter.1 hy).2⟩
    rw [add_assoc, add_comm Z, Multiset.singleton_add]

theorem transGen_replacement_iff : TransGen Replacement M N ↔ IsDershowitzMannaLT M N :=
  ⟨dm_of_transGen_replacement, transGen_replacement_of_dm⟩

/-- Mathlib's ordering is the transitive closure of the public replacement relation. -/
theorem transGen_replacement_eq_dm :
    TransGen (Replacement (α := α)) = IsDershowitzMannaLT := by
  funext M N
  exact propext transGen_replacement_iff

/-- A nonempty multiset over a preorder has an element with nothing strictly above it. -/
theorem exists_maximal_mem {Z : Multiset α} (hZ : Z ≠ 0) : ∃ m ∈ Z, ∀ z ∈ Z, ¬ m < z := by
  induction Z using Multiset.induction_on with
  | empty => exact absurd rfl hZ
  | cons a Z ih =>
    rcases eq_or_ne Z 0 with rfl | hZ'
    · refine ⟨a, by simp, fun z hz => ?_⟩
      obtain rfl : z = a := by simpa using hz
      exact lt_irrefl z
    obtain ⟨m, hm, hmax⟩ := ih hZ'
    by_cases hma : m < a
    · refine ⟨a, by simp, fun z hz haz => ?_⟩
      rcases Multiset.mem_cons.1 hz with rfl | hz
      · exact lt_irrefl _ haz
      · exact hmax z hz (hma.trans haz)
    · refine ⟨m, Multiset.mem_cons_of_mem hm, fun z hz => ?_⟩
      rcases Multiset.mem_cons.1 hz with rfl | hz
      · exact hma
      · exact hmax z hz

/-- Irreflexivity needs no well-foundedness, only the maximal element of a finite multiset. -/
theorem dm_irrefl (M : Multiset α) : ¬ IsDershowitzMannaLT M M := by
  rintro ⟨X, Y, Z, hZ, hM, hN, hYZ⟩
  obtain rfl : Y = Z := add_left_cancel (hM.symm.trans hN)
  obtain ⟨m, hm, hmax⟩ := exists_maximal_mem (by simpa [Multiset.empty_eq_zero] using hZ)
  obtain ⟨z, hz, hmz⟩ := hYZ m hm
  exact hmax z hz hmz

theorem dm_asymm (h : IsDershowitzMannaLT M N) : ¬ IsDershowitzMannaLT N M :=
  fun h' => dm_irrefl M (h.trans h')

/-- Over a trichotomous order the Dershowitz–Manna order is trichotomous too. After removing the
common part, the larger multiset is the one holding the largest remaining element. -/
theorem dm_trichotomous (htri : ∀ a b : α, a < b ∨ a = b ∨ b < a) (M N : Multiset α) :
    IsDershowitzMannaLT M N ∨ M = N ∨ IsDershowitzMannaLT N M := by
  classical
  have hM : M = M ∩ N + (M - M ∩ N) := (add_tsub_cancel_of_le Multiset.inter_le_left).symm
  have hN : N = M ∩ N + (N - M ∩ N) := (add_tsub_cancel_of_le Multiset.inter_le_right).symm
  have hdisj : ∀ a, a ∈ M - M ∩ N → a ∈ N - M ∩ N → False := by
    intro a ha hb
    rw [← Multiset.count_pos] at ha hb
    simp only [Multiset.count_sub, Multiset.count_inter] at ha hb
    omega
  by_cases hY : M - M ∩ N = 0
  · by_cases hZ : N - M ∩ N = 0
    · rw [hY, add_zero] at hM
      rw [hZ, add_zero] at hN
      exact .inr (.inl (hM.trans hN.symm))
    · exact .inl ⟨M ∩ N, 0, N - M ∩ N, by simpa [Multiset.empty_eq_zero] using hZ,
        by rw [add_zero]; exact hM.trans (by rw [hY, add_zero]), hN, by simp⟩
  by_cases hZ : N - M ∩ N = 0
  · exact .inr (.inr ⟨M ∩ N, 0, M - M ∩ N, by simpa [Multiset.empty_eq_zero] using hY,
      by rw [add_zero]; exact hN.trans (by rw [hZ, add_zero]), hM, by simp⟩)
  obtain ⟨m, hm, hmax⟩ := exists_maximal_mem (Z := (M - M ∩ N) + (N - M ∩ N))
    (by simp [hY])
  have below : ∀ z ∈ (M - M ∩ N) + (N - M ∩ N), z ≠ m → z < m := fun z hz hzm => by
    rcases htri z m with h | h | h
    exacts [h, absurd h hzm, absurd h (hmax z hz)]
  rcases Multiset.mem_add.1 hm with hmY | hmZ
  · refine .inr (.inr ⟨M ∩ N, N - M ∩ N, M - M ∩ N, by simpa [Multiset.empty_eq_zero] using hY,
      hN, hM, fun z hz => ⟨m, hmY, below z (Multiset.mem_add.2 (.inr hz)) ?_⟩⟩)
    rintro rfl
    exact hdisj z hmY hz
  · refine .inl ⟨M ∩ N, M - M ∩ N, N - M ∩ N, by simpa [Multiset.empty_eq_zero] using hZ,
      hM, hN, fun z hz => ⟨m, hmZ, below z (Multiset.mem_add.2 (.inl hz)) ?_⟩⟩
    rintro rfl
    exact hdisj z hz hmZ

/-- A common context can be added to both sides of a Dershowitz–Manna descent. -/
theorem dm_add_left (h : IsDershowitzMannaLT M N) (K : Multiset α) :
    IsDershowitzMannaLT (K + M) (K + N) := by
  obtain ⟨X, Y, Z, hZ, rfl, rfl, hYZ⟩ := h
  exact ⟨K + X, Y, Z, hZ, (add_assoc _ _ _).symm, (add_assoc _ _ _).symm, hYZ⟩

/-- Multisets compared by the Dershowitz–Manna order instead of by inclusion. -/
structure DM (α : Type*) where
  /-- The underlying multiset. -/
  toMultiset : Multiset α

instance : PartialOrder (DM α) where
  le M N := IsDershowitzMannaLT M.toMultiset N.toMultiset ∨ M = N
  lt M N := IsDershowitzMannaLT M.toMultiset N.toMultiset
  le_refl _ := .inr rfl
  le_trans _ _ _ := by
    rintro (h₁ | rfl) (h₂ | rfl)
    exacts [.inl (h₁.trans h₂), .inl h₁, .inl h₂, .inr rfl]
  lt_iff_le_not_ge M N := by
    constructor
    · intro h
      exact ⟨.inl h, by rintro (h' | rfl); exacts [dm_asymm h h', dm_irrefl _ h]⟩
    · rintro ⟨h | rfl, h'⟩
      exacts [h, absurd (.inr rfl) h']
  le_antisymm M N := by
    rintro (h | rfl) (h' | h')
    exacts [(dm_asymm h h').elim, (dm_irrefl _ (h' ▸ h)).elim, rfl, rfl]

theorem DM.lt_iff {M N : DM α} : M < N ↔ IsDershowitzMannaLT M.toMultiset N.toMultiset :=
  Iff.rfl

instance [WellFoundedLT α] : WellFoundedLT (DM α) :=
  ⟨InvImage.wf DM.toMultiset Multiset.wellFounded_isDershowitzMannaLT⟩

/-- Multisets nested to depth `d`. Level `d + 1` holds multisets of level-`d` elements, compared
by the Dershowitz–Manna extension of the level-`d` order. -/
def Nested : ℕ → Type
  | 0 => PUnit
  | d + 1 => DM (Nested d)

instance Nested.instPartialOrder : (d : ℕ) → PartialOrder (Nested d)
  | 0 => inferInstanceAs (PartialOrder PUnit)
  | d + 1 =>
    letI := Nested.instPartialOrder d
    inferInstanceAs (PartialOrder (DM (Nested d)))

instance Nested.instWellFoundedLT : (d : ℕ) → WellFoundedLT (Nested d)
  | 0 => ⟨⟨fun x => ⟨x, fun _ h => (lt_irrefl x h).elim⟩⟩⟩
  | d + 1 =>
    letI := Nested.instWellFoundedLT d
    inferInstanceAs (WellFoundedLT (DM (Nested d)))

/-- Build a level-`d + 1` element from a multiset of level-`d` elements. -/
def Nested.ofMultiset {d : ℕ} (M : Multiset (Nested d)) : Nested (d + 1) := DM.mk M

theorem Nested.ofMultiset_lt_ofMultiset {d : ℕ} {M N : Multiset (Nested d)} :
    Nested.ofMultiset M < Nested.ofMultiset N ↔ IsDershowitzMannaLT M N :=
  Iff.rfl

/-- Every finite nesting depth is well founded, by iterating Mathlib's theorem. -/
theorem nested_wellFounded (d : ℕ) : WellFounded ((· < ·) : Nested d → Nested d → Prop) :=
  wellFounded_lt

/-- Any two nested multisets of the same depth are comparable. -/
theorem Nested.lt_trichotomy : ∀ (d : ℕ) (x y : Nested d), x < y ∨ x = y ∨ y < x
  | 0, _, _ => .inr (.inl rfl)
  | d + 1, ⟨M⟩, ⟨N⟩ => by
    rcases dm_trichotomous (Nested.lt_trichotomy d) M N with h | rfl | h
    exacts [.inl h, .inr (.inl rfl), .inr (.inr h)]

/-- Each nesting depth is a well-order, so it has an ordinal as its order type. -/
instance Nested.instIsWellOrder (d : ℕ) : IsWellOrder (Nested d) (· < ·) where
  wf := nested_wellFounded d
  trichotomous x y hxy hyx := by
    rcases Nested.lt_trichotomy d x y with h | h | h
    exacts [absurd h hxy, h, absurd h hyx]

end Descent
